{
  "name": "enterprise-rn-template",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "preflight": "tsx scripts/preflight-env.ts",
    "init-app": "pnpm preflight && tsx scripts/init-app.ts",
    "start": "APP_VARIANT=development expo start --dev-client",
    "start:staging": "APP_VARIANT=staging expo start --dev-client",
    "start:prod": "APP_VARIANT=production expo start --dev-client",
    "prebuild:dev": "pnpm preflight && APP_VARIANT=development expo prebuild",
    "prebuild:staging": "pnpm preflight && APP_VARIANT=staging expo prebuild",
    "prebuild:prod": "pnpm preflight && APP_VARIANT=production expo prebuild",
    "distribute": "tsx scripts/distribute-internal.ts",
    "distribute:dry-run": "tsx scripts/distribute-internal.ts --dry-run",
    "ios": "pnpm preflight && APP_VARIANT=development expo run:ios",
    "android": "pnpm preflight && APP_VARIANT=development expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "test": "jest",
    "e2e:smoke": "maestro test .maestro/smoke.yaml",
    "verify:maestro": "node scripts/verify-maestro-flows.cjs",
    "verify:variants": "node scripts/verify-variant-config.cjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm verify:maestro && pnpm exec jest --runInBand",
    "version:bump": "npm version --no-git-tag-version",
    "test:coverage": "jest --coverage"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write",
      "jest --findRelatedTests --passWithNoTests --bail"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^7.0.7",
    "@react-native-community/netinfo": "^12.0.1",
    "@shopify/flash-list": "^2.3.3",
    "@tanstack/react-query": "^5.108.0",
    "axios": "^1.21.1",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-media-library": "~58.0.14",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "i18next": "^27.1.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.15",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "react-server-dom-webpack": "~19.3.0",
    "test-renderer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
